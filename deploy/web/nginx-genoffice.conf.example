# GenOffice Web production example.
#
# Requirements:
# - NGINX Open Source >= 1.29.6 for `sticky cookie` support.
# - The static bundle from `npm run build:web:all` installed at /opt/genoffice/web.
# - One or more xlsx-engine containers listening on the upstream addresses below.

upstream genoffice_xlsx_engine {
    least_conn;

    # The XLSX engine keeps workbook sessions in process memory. NGINX must
    # keep a browser on the same engine for the lifetime of its workbook
    # sessions. The existing X-Xlsx-Session header remains available for a
    # future session-aware router; phase 1 uses browser cookie affinity.
    sticky cookie genoffice_xlsx_route expires=1h path=/xlsx-engine/ httponly samesite=lax secure;

    server 127.0.0.1:7301 max_fails=2 fail_timeout=10s;
    server 127.0.0.1:7302 max_fails=2 fail_timeout=10s;
    server 127.0.0.1:7303 max_fails=2 fail_timeout=10s;
}

server {
    listen 443 ssl http2;
    server_name web.office.com;

    # Configure the real certificate paths for the deployment.
    # ssl_certificate /etc/letsencrypt/live/web.office.com/fullchain.pem;
    # ssl_certificate_key /etc/letsencrypt/live/web.office.com/privkey.pem;

    root /opt/genoffice/web;
    index index.html;

    # XLSX preservation requests may carry base64-expanded package parts.
    client_max_body_size 400m;

    location = / {
        return 302 /docx/;
    }

    location = /docx { return 308 /docx/; }
    location = /xlsx { return 308 /xlsx/; }
    location = /pptx { return 308 /pptx/; }
    location = /md { return 308 /md/; }
    location = /pdf { return 308 /pdf/; }

    location /docx/ {
        try_files $uri $uri/ /docx/index.html;
    }

    location /xlsx/ {
        try_files $uri $uri/ /xlsx/index.html;
    }

    location /pptx/ {
        try_files $uri $uri/ /pptx/index.html;
    }

    location /md/ {
        try_files $uri $uri/ /md/index.html;
    }

    location /pdf/ {
        try_files $uri $uri/ /pdf/index.html;
    }

    # Vite content-hashed assets are safe to cache aggressively.
    location ~ ^/(docx|xlsx|pptx|md|pdf)/assets/ {
        try_files $uri =404;
        expires 1y;
        add_header Cache-Control "public, immutable";
    }

    location = /xlsx-engine/metrics {
        allow 127.0.0.1;
        allow ::1;
        deny all;

        proxy_pass http://genoffice_xlsx_engine/metrics;
        proxy_set_header X-Request-Id $request_id;
    }

    location /xlsx-engine/ {
        # The trailing slash strips the public /xlsx-engine prefix. The Rust
        # service continues exposing /health and /v1/* internally.
        proxy_pass http://genoffice_xlsx_engine/;

        proxy_set_header Host $host;
        proxy_set_header X-Request-Id $request_id;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;

        proxy_connect_timeout 5s;
        proxy_send_timeout 900s;
        proxy_read_timeout 900s;
    }

    # GenOffice is designed to run inside the UC Web OS iframe. Configure
    # frame-ancestors to the exact UC production origin(s) before deployment.
    # add_header Content-Security-Policy "frame-ancestors 'self' https://uc.example.com" always;
}
